APP_NAME=smsbridge
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://smsbridge:smsbridge@postgres:5432/smsbridge
REDIS_URL=redis://redis:6379/0
# Production/staging must override SECRET_KEY with a unique random value of at least 32 characters.
SECRET_KEY=change-this-in-production
# Local seed password. Production/staging must override this if seed is used.
ADMIN_SEED_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_MINUTES=20160
MOCK_SUCCESS_RATE=0.85
MOCK_SMS_DELAY_SECONDS=10
MOCK_ORDER_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=120
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

