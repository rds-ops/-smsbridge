APP_NAME=smsbridge
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://smsbridge:smsbridge@postgres:5432/smsbridge
REDIS_URL=redis://redis:6379/0
# Production/staging must override SECRET_KEY with a unique random value of at least 32 characters.
SECRET_KEY=change-this-in-production
# Local seed password. Production/staging must override this if seed is used.
ADMIN_SEED_PASSWORD=change-me
# Production/staging must use an exact HTTPS origin list. Do not use wildcard origins.
CORS_ORIGINS=http://localhost:3000
# Shared secret for internal provider/payment webhook skeletons.
# Production/staging must override this with a unique random value.
INTERNAL_WEBHOOK_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_MINUTES=20160
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
MOCK_SUCCESS_RATE=0.85
MOCK_SMS_DELAY_SECONDS=10
MOCK_ORDER_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=120
# Optional identity-aware rate limit overrides. If omitted, RATE_LIMIT_PER_MINUTE and simple tier multipliers are used.
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=120
# RATE_LIMIT_USER_DEFAULT_PER_MINUTE=120
# RATE_LIMIT_USER_VERIFIED_PER_MINUTE=240
# RATE_LIMIT_USER_WHOLESALE_PER_MINUTE=600
# RATE_LIMIT_USER_PARTNER_PER_MINUTE=1200
# RATE_LIMIT_SUPPLIER_PER_MINUTE=120
# RATE_LIMIT_ADMIN_PER_MINUTE=1000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

